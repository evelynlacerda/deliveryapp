generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum TipoEntrega {
    ENTREGA
    RETIRADA
}

enum FormaPagamento {
    DINHEIRO
    CARTAO
    PIX
}

enum TipoChavePix {
    CPF
    CNPJ
    TELEFONE
    ALEATORIA
}

enum StatusPedido {
    // Quando for Pix:
    AGUARDANDO_PAGAMENTO
    PAGAMENTO_APROVADO
    // Pedidos em geral:
    AGUARDANDO
    EM_PRODUCAO
    EM_ROTA_ENTREGA
    PRONTO_RETIRADA
    FINALIZADO
}

model Sabor {
    id    Int          @id @default(autoincrement())
    nome  String       @unique @db.VarChar(80)
    ativo Boolean      @default(true)
    itens ItemPedido[]
}

model FaixaPreco {
    id         Int     @id @default(autoincrement())
    quantidade Int     @unique
    valor      Decimal @db.Decimal(10, 2)
}

// Linha única (id = 1) com os parâmetros ajustáveis pelo admin.
model Configuracao {
    id                              Int          @id @default(1)
    tempoPreparoMinimoMin           Int          @default(30)
    tempoPreparoMaximoMin           Int          @default(60)
    valorUnidadeAcimaDe100          Decimal      @default(0.64) @db.Decimal(10, 2)
    taxaEntregaAte49                Decimal      @default(7.00) @db.Decimal(10, 2)
    taxaEntregaDe50a199             Decimal      @default(5.00) @db.Decimal(10, 2)
    entregaGratisAPartirDe          Int          @default(200)
    tipoChavePix                    TipoChavePix @default(CPF)
    chavePix                        String       @default("00000000000") @db.VarChar(100)
    titularPix                      String?      @db.VarChar(80)
    bancoPix                        String?      @db.VarChar(80)
    whatsappEstabelecimento         String?      @db.VarChar(20)
    pixAntecedenciaAteLimiteHoras   Int          @default(2)
    pixAntecedenciaAcimaLimiteHoras Int          @default(4)
    horarioAbertura                 String?      @db.VarChar(5)
    horarioFechamento               String?      @db.VarChar(5)
    estabelecimentoFechado          Boolean      @default(false)
    diasAtendimento                 Int[]        @default([0, 1, 2, 3, 4, 5, 6])
    enderecoRetirada                String?      @db.VarChar(300)
    entregaSuspensaEm               String?      @db.VarChar(10)
    nomeMarca                       String       @default("DeliveryApp") @db.VarChar(60)
    logoDados                       Bytes?
    logoTipo                        String?      @db.VarChar(30)
    logoAtualizadaEm                DateTime?
    logoEscuraDados                 Bytes?
    logoEscuraTipo                  String?      @db.VarChar(30)
    logoEscuraAtualizadaEm          DateTime?
    cores                           Json?
}

model Pedido {
    id                   String         @id @default(uuid()) @db.Uuid
    codigo               String         @unique @db.VarChar(12)
    nomeCliente          String         @db.VarChar(120)
    telefone             String         @db.VarChar(20)
    tipoEntrega          TipoEntrega
    endereco             String?        @db.VarChar(300)
    pontoReferencia      String?        @db.VarChar(200)
    observacao           String?        @db.VarChar(500)
    horarioAgendado      DateTime?
    formaPagamento       FormaPagamento
    enderecoRetirada     String?        @db.VarChar(300)
    precisaTroco         Boolean        @default(false)
    trocoPara            Decimal?       @db.Decimal(10, 2)
    status               StatusPedido   @default(AGUARDANDO)
    quantidadeTotal      Int
    subtotal             Decimal        @db.Decimal(10, 2)
    taxaEntrega          Decimal        @db.Decimal(10, 2)
    total                Decimal        @db.Decimal(10, 2)
    tempoPreparoMin      Int?
    previsaoEm           DateTime?
    pixAntecedenciaHoras Int?
    pagarAte             DateTime?
    criadoEm             DateTime       @default(now())
    itens                ItemPedido[]

    @@index([status, criadoEm])
}

model ItemPedido {
    id         Int    @id @default(autoincrement())
    pedidoId   String @db.Uuid
    pedido     Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
    saborId    Int?
    sabor      Sabor? @relation(fields: [saborId], references: [id], onDelete: Restrict)
    quantidade Int?
}

model AdminUser {
    id        Int    @id @default(autoincrement())
    usuario   String @unique @db.VarChar(60)
    senhaHash String
}
