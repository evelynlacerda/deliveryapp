NODE_ENV=development
PORT=3333
WEB_URL=http://localhost:5173

# Connection string do Neon. Local e migrations/seed: use a string direta (sem "-pooler").
# API na Vercel (serverless): use a string com "-pooler".
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Banco separado, só para os testes automatizados (pode ser uma branch do Neon).
DATABASE_TESTS_URL=postgresql://usuario:senha@host/neondb_test?sslmode=require

# Segredo do JWT do admin (mínimo 32 caracteres). Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Aviso de novo pedido no celular (ntfy, opcional). O tópico funciona como senha: use um nome longo e aleatório.
# NTFY_SERVER só se você hospedar o seu próprio ntfy (padrão: https://ntfy.sh).
NTFY_TOPIC=
NTFY_SERVER=

# Admin inicial criado pelo seed (npm run db:seed).
ADMIN_USER=
ADMIN_PASSWORD=
# Demo pública: use ADMIN_USER=admin123 e ADMIN_PASSWORD=123deliveryapp! (os mesmos mostrados na tela de login).

# Demo pública: true (padrão) trava a chave Pix em 12345678900 e impede a troca pelo painel.
# Use false para usar o app de verdade, com a sua chave.
MODO_DEMO=true

# Limpeza diária de pedidos (Vercel Cron chama GET /cron/limpar-pedidos às 03:00 UTC).
# A Vercel envia este valor como "Authorization: Bearer <valor>". Mínimo 16 caracteres; sem ele a rota fica desligada.
CRON_SECRET=
